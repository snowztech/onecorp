{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneCorp",
  "version": "0.1.7",
  "identifier": "dev.onecorp.desktop",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OneCorp",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run a company of AI employees",
    "copyright": "OneCorp",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNURFOTkyQUQ1NjVEQzEKUldUQlhWYXRrdWxkd25MUWZncEd2YnAvTW1obkNhYWsyWFI0U1JEa09ya3huZzZ5V0M1ZlAyQlcK",
      "endpoints": [
        "https://github.com/snowztech/onecorp/releases/latest/download/latest.json"
      ]
    }
  }
}
