{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneCorp",
  "version": "0.1.2",
  "identifier": "dev.onecorp.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OneCorp",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run a company of AI employees",
    "copyright": "OneCorp",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
